with "config/backup_config.gpr";
project Backup is

   Target_OS := external ("BACKUP_TARGET_OS", Backup_Config.Alire_Host_OS);

   case Target_OS is
      when "windows" =>
         for Source_Dirs use ("src/", "src/windows/", "config/");
      when others =>
         for Source_Dirs use ("src/", "src/unix/", "config/");
   end case;
   for Object_Dir use "obj/" & Target_OS & "/" & Backup_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("backup-main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Backup_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnata", "-gnatW8", "-gnatwa", "-gnatVa");
   end Compiler;

   package Builder is
      for Executable ("backup-main.adb") use "backup";
   end Builder;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-lssl", "-lcrypto");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Backup;
