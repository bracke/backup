--  Standalone build helper: copies the i18n dependency's generated locale data
--  into the backup crate's share/i18n tree. Deliberately its own project with no
--  dependencies, so it builds with plain gprbuild (no Alire solve) and lands in
--  tools/i18n_bundle/bin -- NOT the app's bin -- so `alr install` never ships it.
--  Built and run by the backup post-build actions (see ../../alire.toml).
project Bundle_I18n_Data is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("bundle_i18n_data.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatyM120");
   end Compiler;
end Bundle_I18n_Data;
