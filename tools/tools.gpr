with "config/backup_tools_config.gpr";

project Tools is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Backup_Tools_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("check_all.adb", "package_release.adb", "generate_manpage.adb", "check_manpage.adb", "generate_cli_surface.adb", "check_cli_surface.adb", "check_bash_completion.adb", "check_fish_completion.adb", "check_zsh_completion.adb", "check_powershell_completion.adb", "check_s3_compatibility.adb", "check_google_drive_compatibility.adb", "check_pcloud_compatibility.adb", "check_proton_drive_compatibility.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Backup_Tools_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnata", "-gnatW8", "-gnatwa", "-gnatwJ");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;
end Tools;
